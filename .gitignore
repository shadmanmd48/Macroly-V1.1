venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# SQLite & Local Databases
macroly.db
backend/macroly.db
*.db
*.sqlite
*.sqlite3

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Unit Tests & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE / Editor Settings
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
