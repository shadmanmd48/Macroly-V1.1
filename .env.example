# ==============================================================================
# Macroly - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# Do NOT commit your real '.env' file containing production credentials to git.

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL connection string (e.g., Supabase Postgres connection pool or direct URL)
# Example: postgresql://postgres:your_password@db.yourproject.supabase.co:5432/postgres
# If left empty, Macroly will automatically fall back to local SQLite for development.
DATABASE_URL=postgresql://postgres:your_password@db.yourproject.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. Supabase Authentication & Client Configuration
# ------------------------------------------------------------------------------
# Supabase project URL and anonymous API key (public client key).
# Used for verifying user JWT tokens on protected backend endpoints.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------------------------------------------
# 3. AI / LLM Engine Credentials
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Primary LLM engine for high-speed natural language parsing)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Secondary/fallback LLM engine)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback LLM engine)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 4. Nutrition Database Credentials (FatSecret Platform)
# ------------------------------------------------------------------------------
# FatSecret REST API credentials for accurate branded/whole food nutritional lookup.
# Register at: https://platform.fatsecret.com/api/
FATSECRET_CLIENT_ID=your_fatsecret_client_id_here
FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret_here
